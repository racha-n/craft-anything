{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental SP scalar candidate receipt version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_sha256", "output_sha256", "admitted_build", "changes", "sections", "internal_reparse_passed", "native_reopen_verified", "derived_schedule_consistency_verified", "limitations"],
  "properties": {
    "version": {"const": 1},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "admitted_build": {"const": "6.5.5.28"},
    "changes": {
      "type": "array", "minItems": 0, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "task_guid", "decoded_tasks_offset", "before_hex", "after_hex"],
        "properties": {
          "field": {"enum": ["task_start", "task_duration", "direct_fixed_amount", "assignment_planned_units", "assignment_planned_rate"]},
          "task_guid": {"type": "string", "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
          "decoded_tasks_offset": {"type": "integer", "minimum": 0, "maximum": 16777208},
          "before_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "after_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
        }
      }
    },
    "sections": {
      "type": "array", "minItems": 48, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "source_stored_sha256", "output_stored_sha256", "stored_bytes_preserved"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 40},
          "source_stored_sha256": {"$ref": "#/$defs/hash"},
          "output_stored_sha256": {"$ref": "#/$defs/hash"},
          "stored_bytes_preserved": {"type": "boolean"}
        }
      }
    },
    "internal_reparse_passed": {"const": true},
    "native_reopen_verified": {"const": false},
    "derived_schedule_consistency_verified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
