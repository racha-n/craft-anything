{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental explicit editable unassigned task export receipt version 8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_sha256",
    "output_sha256",
    "prefix",
    "stages",
    "internal_reparse_passed",
    "native_reopen_verified",
    "derived_schedule_consistency_verified",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": 8
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "output_sha256": {
      "$ref": "#/$defs/hash"
    },
    "prefix": {
      "$ref": "sp-structural-candidate-receipt-v4.schema.json"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "create"
              },
              "receipt": {
                "$ref": "sp-task-create-candidate-receipt-v2.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "fields"
              },
              "receipt": {
                "$ref": "sp-mixed-candidate-receipt-v2.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "order"
              },
              "receipt": {
                "$ref": "sp-task-order-candidate-receipt-v2.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "hierarchy"
              },
              "receipt": {
                "$ref": "sp-task-hierarchy-candidate-receipt-v1.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "delete"
              },
              "receipt": {
                "$ref": "sp-task-delete-candidate-receipt-v1.schema.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt"
            ],
            "properties": {
              "kind": {
                "const": "presentation_rows"
              },
              "receipt": {
                "$ref": "sp-task-presentation-rows-receipt-v1.schema.json"
              }
            }
          }
        ]
      }
    },
    "internal_reparse_passed": {
      "const": true
    },
    "native_reopen_verified": {
      "const": false
    },
    "derived_schedule_consistency_verified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Explicit export with a complete admitted task presentation map. Default chronological exports retain versions 5 through 7. Fresh drafts revalidate independently; per-target deletion reference scans remain required."
}
