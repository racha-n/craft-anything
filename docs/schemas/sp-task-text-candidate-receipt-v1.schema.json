{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental SP task text candidate receipt version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_sha256",
    "output_sha256",
    "admitted_build",
    "changes",
    "sections",
    "internal_reparse_passed",
    "native_reopen_verified",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "output_sha256": {
      "$ref": "#/$defs/hash"
    },
    "admitted_build": {
      "const": "6.5.5.28"
    },
    "changes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "task_guid",
          "source_decoded_offset",
          "source_encoded_bytes",
          "output_encoded_bytes",
          "expected",
          "value"
        ],
        "properties": {
          "field": {
            "enum": [
              "task_name",
              "task_display_id"
            ]
          },
          "task_guid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "source_decoded_offset": {
            "type": "integer",
            "minimum": 0
          },
          "source_encoded_bytes": {
            "type": "integer",
            "minimum": 4,
            "maximum": 32774
          },
          "output_encoded_bytes": {
            "type": "integer",
            "minimum": 4,
            "maximum": 32774
          },
          "expected": {
            "$ref": "#/$defs/source_text"
          },
          "value": {
            "$ref": "#/$defs/output_text"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_stored_sha256",
          "output_stored_sha256",
          "stored_bytes_preserved"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "source_stored_sha256": {
            "$ref": "#/$defs/hash"
          },
          "output_stored_sha256": {
            "$ref": "#/$defs/hash"
          },
          "stored_bytes_preserved": {
            "type": "boolean"
          }
        }
      }
    },
    "internal_reparse_passed": {
      "const": true
    },
    "native_reopen_verified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_text": {
      "type": "string",
      "maxLength": 16384,
      "description": "Decoded source text; the producer additionally caps UTF-16 code units at 16384."
    },
    "output_text": {
      "type": "string",
      "maxLength": 16384,
      "not": {
        "pattern": "\u0000"
      },
      "description": "The producer enforces 16384 UTF-16 code units, including surrogate pairs."
    }
  }
}
