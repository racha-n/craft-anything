{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental SP task hierarchy candidate receipt version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_sha256",
    "output_sha256",
    "admitted_build",
    "sections",
    "internal_reparse_passed",
    "native_reopen_verified",
    "limitations",
    "relocation",
    "task_count",
    "derived_schedule_recalculated",
    "task_guids_preserved",
    "task_body_fields_preserved",
    "collection_lookup_indices_validated",
    "collection_lookup_indices_rebuilt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "output_sha256": {
      "$ref": "#/$defs/hash"
    },
    "admitted_build": {
      "const": "6.5.5.28"
    },
    "sections": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_stored_sha256",
          "output_stored_sha256",
          "stored_bytes_preserved"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "source_stored_sha256": {
            "$ref": "#/$defs/hash"
          },
          "output_stored_sha256": {
            "$ref": "#/$defs/hash"
          },
          "stored_bytes_preserved": {
            "type": "boolean"
          }
        }
      }
    },
    "internal_reparse_passed": {
      "const": true
    },
    "native_reopen_verified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_guid",
        "expected_parent_guid",
        "expected_sibling_index",
        "sibling_index",
        "parent_guid"
      ],
      "properties": {
        "task_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "expected_parent_guid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_sibling_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "sibling_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "parent_guid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "derived_schedule_recalculated": {
      "const": false
    },
    "task_guids_preserved": {
      "const": true
    },
    "task_body_fields_preserved": {
      "const": true
    },
    "collection_lookup_indices_validated": {
      "const": true
    },
    "collection_lookup_indices_rebuilt": {
      "const": true
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
