{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental mixed SP candidate receipt version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_sha256",
    "output_sha256",
    "scalar_stage",
    "text_stage",
    "internal_reparse_passed",
    "native_reopen_verified",
    "derived_schedule_consistency_verified",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "output_sha256": {
      "$ref": "#/$defs/hash"
    },
    "scalar_stage": {
      "$ref": "sp-candidate-receipt-v1.schema.json"
    },
    "text_stage": {
      "$ref": "sp-task-text-candidate-receipt-v1.schema.json"
    },
    "internal_reparse_passed": {
      "const": true
    },
    "native_reopen_verified": {
      "const": false
    },
    "derived_schedule_consistency_verified": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Consumers must additionally verify the source/intermediate/output hash chain and the combined maximum of 256 changed fields."
}
