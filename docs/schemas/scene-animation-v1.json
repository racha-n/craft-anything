{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Scene camera/focus animation version 1",
  "additionalProperties": false,
  "required": [
    "version",
    "scene_id",
    "keyframes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "keyframes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "description": "First seconds must be zero, subsequent times strictly increase, up axis identical; enforced by engine.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seconds",
          "camera",
          "focus"
        ],
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "yaw",
              "pitch",
              "distance",
              "y_up"
            ],
            "properties": {
              "target": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -1e+18,
                  "maximum": 1e+18
                }
              },
              "yaw": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              },
              "pitch": {
                "type": "number",
                "minimum": -1.5707963267948966,
                "maximum": 1.5707963267948966
              },
              "distance": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 100000000000000.0
              },
              "y_up": {
                "type": "boolean"
              }
            }
          },
          "focus": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        }
      }
    }
  }
}
